rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth.uid != null;
    }

    // Admins are viewers too: everything a viewer may do, an admin may do.
    function isViewer() {
      return request.auth.token.email_verified
        && (getRoles().get('viewers', []).hasAll([request.auth.token.email])
          || getRoles().get('admins', []).hasAll([request.auth.token.email]));
    }

    function isAdmin() {
      return request.auth.token.email_verified && getRoles().get('admins', []).hasAll([request.auth.token.email]);
    }

    function getRoles() {
      return get(/databases/$(database)/documents/admin/roles).data;
    }

    function areSetsEqual(list1, list2) {
      return list1.hasAll(list2) && list2.hasAll(list1);
    }

    // Admins may write any story field, but the document still has to keep its shape:
    // no unknown keys, and no dropping the fields the app relies on.
    function isValidStory(data) {
      return data.keys().hasOnly(['title', 'description', 'solution', 'number', 'personsWhoKnow', 'usersWhoStarred', 'isArchived'])
        && data.title is string && data.title.size() > 0
        && data.description is string
        && data.solution is string
        && data.number is int && data.number >= 0
        && data.personsWhoKnow is list
        && data.get('usersWhoStarred', []) is list
        && data.get('isArchived', false) is bool;
    }

    match /stories/{storyId} {
      allow read: if isSignedIn() && isViewer();
      // Admins create stories; the app never deletes them, it archives them instead.
      allow create: if isSignedIn() && isAdmin() && isValidStory(request.resource.data);
      allow update: if isSignedIn() && isAdmin() && isValidStory(request.resource.data);
      allow update: if isSignedIn() && isViewer() && (
        // Allow updating personsWhoKnow
        areSetsEqual(request.writeFields, ["personsWhoKnow"])
        // Allow updating usersWhoStarred only by adding/removing your own uid
        || (
          areSetsEqual(request.writeFields, ["usersWhoStarred"])
          && (
            // Adding yourself: new list is old list + your uid
            // Use get() with default [] to handle stories created before the starring feature
            (request.resource.data.usersWhoStarred.hasAll(resource.data.get('usersWhoStarred', []))
              && request.resource.data.usersWhoStarred.size() == resource.data.get('usersWhoStarred', []).size() + 1
              && request.resource.data.usersWhoStarred.hasAll([request.auth.uid]))
            ||
            // Removing yourself: new list is old list minus your uid
            (resource.data.get('usersWhoStarred', []).hasAll(request.resource.data.usersWhoStarred)
              && request.resource.data.usersWhoStarred.size() == resource.data.get('usersWhoStarred', []).size() - 1
              && !request.resource.data.usersWhoStarred.hasAll([request.auth.uid]))
          )
        )
      );
      allow delete: if false;
    }

    match /admin/roles {
      allow read: if isSignedIn() && isAdmin();
      // Admins may edit the viewers and admins lists, but cannot remove themselves
      // from admins — that both prevents accidental lockout and guarantees the
      // admins field cannot be dropped or emptied through the client.
      allow update: if isSignedIn() && isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewers', 'admins'])
        && request.resource.data.get('viewers', []) is list
        && request.resource.data.get('admins', []) is list
        && request.resource.data.get('admins', []).hasAll([request.auth.token.email]);
      allow create, delete: if false;
    }

    match /persons/{document=**} {
      allow read, create: if isSignedIn() && isViewer();
      allow update, delete: if false;
    }

    match /camps/{document=**} {
      allow read, create, update: if isSignedIn() && isViewer();
      allow delete: if false;
    }
  }
}